# Runtime configuration for local development
# Copy to .env and adjust values as needed

QDRANT_URL=http://localhost:6333
VECTOR_NAME=bge-m3-1024
EMBEDDING_MODEL=Xenova/bge-m3
EMBEDDING_DIMENSIONS=1024

# Qdrant Embedded configuration (alternative to external Qdrant)
# When using embedded mode, set QDRANT_EMBEDDED=true and provide local path
QDRANT_EMBEDDED=false
QDRANT_EMBEDDED_PATH=./qdrant_storage

# Collection name (optional, default: gsd_memory)
COLLECTION_NAME=gsd_memory
